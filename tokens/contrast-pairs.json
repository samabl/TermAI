{
  "$schema": "./contrast-pairs.schema.json",
  "version": "1.0.0",
  "standard": "WCAG 2.x（相对亮度公式）",
  "thresholds": {
    "text": 4.5,
    "ui": 3
  },
  "description": "需要在 dark/light 两套主题下校验对比度的前景/背景配对（AR-22 第 1 条 / DC-13 / A9 / A24）。kind=text 为正文/小字（≥4.5:1），kind=ui 为图标/大字号/UI 组件（≥3.0:1）。bg 为 rgba 时必须给 bgBase 以合成不透明底色。终端 chrome 与终端画布在深/浅两主题下均为深色（--term-* 不随主题变化）。",
  "pairs": [
    {
      "id": "text-on-canvas",
      "category": "正文",
      "fg": "text",
      "bg": "canvas",
      "kind": "text"
    },
    {
